# Copiá este archivo como backend/.env y completá los valores. NUNCA subas el .env a GitHub ni lo mandes por chat/zip.

# Clave de Gemini (se crea gratis en Google AI Studio: https://aistudio.google.com/apikey).
# Sin clave la app funciona igual, en "modo reglas" (sin IA).
GEMINI_API_KEY=pegá_acá_tu_clave_nueva_de_Google_AI_Studio
GEMINI_MODEL=gemini-2.5-flash
PORT=8001

# Base de datos. Vacío = SQLite (archivo laborea.db, no hace falta instalar nada).
# Para PostgreSQL:  DATABASE_URL=postgresql://usuario:clave@localhost:5432/laborea
DATABASE_URL=

# Cuota de Gemini (plan gratis): pedidos por minuto que el backend se permite y segundos máximos de espera
# antes de responder en "modo reglas". Si Gemini no contesta en GEMINI_TIMEOUT segundos, se usa el modo reglas.
GEMINI_RPM=4
GEMINI_MAX_ESPERA=6
GEMINI_TIMEOUT=30

# Dominios del frontend permitidos (separados por coma). En producción: https://tu-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límites por IP y por hora
LIMITE_SESIONES_HORA=20
LIMITE_CHAT_HORA=80
LIMITE_CV_HORA=10

# Privacidad: se borran las sesiones (y los CV) sin actividad hace más de N días. 0 = no borrar.
RETENCION_DIAS=30

# En el servidor publicado poné ENTORNO=produccion: oculta /docs, /redoc y /openapi.json
ENTORNO=desarrollo
